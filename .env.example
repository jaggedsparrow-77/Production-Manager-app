# Copy to .env.local and fill in. Never commit .env.local.
#
#   cp .env.example .env.local
#
# Every variable listed here is validated at startup by src/env.ts — the app
# fails fast with a readable error rather than dying deep in a request.

# --- Database -------------------------------------------------------------
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/callboard"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Required in production; inferred from the request in development.
# AUTH_URL="https://your-domain.example"

# --- GitHub OAuth (optional) ---------------------------------------------
# Create at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Local development convenience ---------------------------------------
# Enables a password-less "sign in as a seeded user" form on /login. Try
# producer@northernrep.example after `npm run db:seed`.
# Hard-blocked in production: the app refuses to boot if this is true there.
ALLOW_DEV_LOGIN="true"
